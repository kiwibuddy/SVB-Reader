{
  "name": "sourceview-together",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "start": "npx expo start",
    "start:dev": "npx expo start --dev-client --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios-preview": "eas build --platform ios --profile preview",
    "build:ios-simulator": "eas build --platform ios --profile production-simulator",
    "build:dev-local": "eas build --platform ios --profile development-local",
    "build:android": "eas build --platform android --profile production",
    "build:android-preview": "eas build --platform android --profile preview",
    "build:android-dev": "eas build --platform android --profile development-android",
    "build:android-dev-local": "eas build --platform android --profile development-local",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:production": "eas update --branch production",
    "update:preview": "eas update --branch preview",
    "prebuild": "expo prebuild --clean",
    "build:local": "expo run:ios --configuration Release",
    "prepare:appstore": "node scripts/prepare-app-store-build.js"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@emnapi/runtime": "1.5.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.9.38",
    "@react-navigation/native": "^7.0.14",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.14",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-web-browser": "~57.0.2",
    "i18next": "^24.2.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "^15.1.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-deprecation": "^2.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.34.3",
    "sqlite3": "^5.1.7",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
