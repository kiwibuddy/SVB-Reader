########################################################################
# EAS CLI uses this file INSTEAD OF .gitignore when deciding what to
# upload to the build servers. It must therefore repeat everything in
# .gitignore that should stay out of a build, plus anything that is
# committed to the repo but is not part of the app.
#
# Keep in sync with .gitignore.
########################################################################

node_modules

expo-env.d.ts
/.expo
.DS_Store
/dist
my-key.keystore

# Native projects are generated by `npx expo prebuild` (managed workflow)
/ios
/android

# Build artifacts
*.ipa
*.apk
*.aab

# Logs and temporary files
*.log
*.tmp
*.cache
.expo/
dist/

# Downloaded on demand from Firebase
assets/data/FRA-Bible.json

# Credentials
google-service-account.json
metadata.json

docs/development/cursor_plan_for_adding_french_language.md

########################################################################
# Committed to the repo, never shipped in the app
########################################################################

# Ad and campaign source. Browser-rendered JSX/HTML that is not part of
# the React Native app and must not reach a build, an OTA update, or the
# EAS upload tarball.
/Marketing
