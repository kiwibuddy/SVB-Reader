{
  "expo": {
    "name": "SourceView Together",
    "slug": "SVB-Youth",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "description": "Experience the Bible in community with SourceView Together - a revolutionary app that transforms solo Bible reading into dynamic group experiences. Featuring role-based reading, emoji reactions, reading plans, challenges, and progress tracking for individuals and groups.",
    "keywords": ["bible", "scripture", "reading", "christian", "group", "community", "devotional", "spiritual", "faith", "religion", "study", "prayer"],
    "primaryColor": "#FF5733",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sourceview.together",
      "buildNumber": "1",
      "privacyPolicy": "mailto:sourceviewbible@gmail.com?subject=Privacy%20Policy%20Request&body=Please%20send%20me%20the%20privacy%20policy%20for%20SourceView%20Together%20app.",
      "supportURL": "mailto:sourceviewbible@gmail.com?subject=SourceView%20Together%20Support&body=Please%20describe%20your%20issue%20or%20question:",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes for joining group reading sessions.",
        "CFBundleDisplayName": "SourceView Together",
        "CFBundleName": "SourceView Together"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "package": "com.sourceview.together",
      "versionCode": 7
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
      "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-av",
      [
        "expo-sqlite",
        {
          "version": "latest"
        }
      ],
        [
          "expo-camera",
          {
            "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
            "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
          }
        ],

      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4b89909c-ac28-498a-9e46-5591000b8616"
      },
      "watchman": false
    },
    "owner": "kiwibuddy",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000,
      "url": "https://u.expo.dev/4b89909c-ac28-498a-9e46-5591000b8616",
      "requestHeaders": {
        "expo-platform": "ios"
      }
    }
  }
}
