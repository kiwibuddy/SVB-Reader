{
  "expo": {
    "name": "SourceView Together",
    "slug": "SVB-Youth",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "description": "SourceView Together is a Bible you read by voice. Every word is attributed to who spoke it — 774 voices across 365 stories. Read alone or together using the four ink colours. No camera, no QR codes.",
    "primaryColor": "#FF5733",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sourceview.together",
      "buildNumber": "21",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "SourceView Together",
        "CFBundleName": "SourceView Together"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#808080"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.sourceview.together",
      "versionCode": 21,
      "allowBackup": true,
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#808080"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "version": "latest"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4b89909c-ac28-498a-9e46-5591000b8616"
      },
      "watchman": false,
      "storeKeywords": [
        "bible",
        "bible study",
        "bible reading",
        "group bible study",
        "christian app",
        "scripture",
        "bible app",
        "reading plans",
        "bible reading app",
        "sourceview",
        "together",
        "group reading",
        "family bible study",
        "small group",
        "religion",
        "faith"
      ]
    },
    "owner": "kiwibuddy",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000,
      "url": "https://u.expo.dev/4b89909c-ac28-498a-9e46-5591000b8616"
    }
  }
}
