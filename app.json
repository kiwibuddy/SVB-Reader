{
  "expo": {
    "name": "SourceView Together",
    "slug": "SVB-Youth",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "description": "The Bible told as 365 stories, with every word coloured by who spoke it. Read it out loud with three friends — one person takes each colour — or on your own. React and note any verse, follow a reading plan, and watch your year fill in.",
    "primaryColor": "#FF5733",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sourceview.together",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "SourceView Together",
        "CFBundleName": "SourceView Together"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#808080"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.sourceview.together",
      "versionCode": 22,
      "allowBackup": true,
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#808080"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "version": "latest"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4b89909c-ac28-498a-9e46-5591000b8616"
      },
      "watchman": false,
      "storeKeywords": [
        "bible",
        "scripture",
        "bible study",
        "read aloud",
        "small group",
        "family devotions",
        "reading plan",
        "devotional",
        "christian",
        "church",
        "youth group",
        "nlt",
        "offline bible",
        "sourceview",
        "together",
        "faith"
      ]
    },
    "owner": "kiwibuddy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000,
      "url": "https://u.expo.dev/4b89909c-ac28-498a-9e46-5591000b8616"
    }
  }
}
